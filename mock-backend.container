[Unit]
Description=ESP RGB Mock Backend

[Container]

# Use a fully qualified image
Image=docker.io/library/node:20
# Mount your repo into the container
Volume=/srv/esp_rgb_mock_backend:/app:Z
Volume=/srv/esp_rgb_mock_backend/start-mock-backend.sh:/start-mock-backend.sh:Z
WorkingDir=/app
# Run entrypoint script inside the container
ExecStart=/bin/sh /start-mock-backend.sh
# Expose port 3000 inside the pod
PublishPort=3000

[Install]
WantedBy=default.target
