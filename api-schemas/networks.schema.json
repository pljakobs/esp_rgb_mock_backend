{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/networks response",
  "type": "object",
  "properties": {
    "scanning": { "type": "boolean" },
    "available": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "ssid": { "type": "string" },
          "signal": { "type": "integer" },
          "encryption": { "type": "string" }
        },
        "required": ["id", "ssid", "signal", "encryption"]
      }
    }
  },
  "required": ["scanning"]
}
